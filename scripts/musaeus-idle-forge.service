# A template: put your MUSAEUS checkout's path in both lines below before
# installing it into ~/.config/systemd/user/.
[Unit]
Description=MUSAEUS Idle-Aware LUFS Forge
Documentation=file:///path/to/MUSAEUS/scripts/idle_forge.sh
After=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
ExecStart=/path/to/MUSAEUS/scripts/idle_forge.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
